    for key,value in pairs(values) do if not before.schema[key] and value~=0 then status("Stat is not available on this character: "..key);return end end
    local activeValues={};for key in pairs(before.schema) do activeValues[key]=values[key] or 0 end
    local plan,reason=Core.plan(activeValues,before.current,before.available,before.schema)
    if not plan then status(reason);return end
    local lines={string.format("Available: %d  ·  Allocated: %d  ·  Target total: %d",plan.available,plan.allocated,plan.total)}
    table.insert(lines,"Required allocation: "..plan.required)
    for _,c in ipairs(plan.changes) do if c.before~=c.after then table.insert(lines,c.name..": "..c.before.." → "..c.after) end end
    local count=essenceCount()
    if plan.reset then
        if not count or count<1 then status("This profile needs a reset. No verified SP Reset Essence is available. Use the game's reset UI first.");return end
        table.insert(lines,"\nCOST: consumes 1 SP Reset Essence.\nReset must be confirmed before allocation starts. There is no Robux purchase in this panel.")
    else table.insert(lines,"\nNo reset cost. Only currently unspent points will be used.") end
    table.insert(lines,"The live server enforces additional caps and eligibility. A rejection stops the sequence; already-confirmed points are not rolled back.")
