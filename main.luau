local function waitUntil(predicate,rev,timeout)
    local deadline=os.clock()+timeout
    repeat
        if not state.running or state.revision~=rev or not characterParts() then return false,"Cancelled because the character or panel changed." end
        if predicate() then return true end
        task.wait(0.1)
    until os.clock()>=deadline
    return false,"Server confirmation timed out. No retry was sent."
end
local function liveEqual(before)
    local now=snapshot()
    if not now or now.stats~=before.stats or now.available~=before.available then return false end
    for key,value in pairs(before.current) do if now.current[key]~=value then return false end end
    return true
end
local function runProfile(before,plan,essences)
    if state.transaction then status("A stat operation is already waiting for server confirmation.");return end
    if not liveEqual(before) then status("Stats changed after preview. Preview again.");return end
    local remote=statRemote()
    if not remote then status("The game's stats remote is unavailable.");return end
    if not characterParts() then status("A living character is required.");return end
    state.transaction=true
    local rev=state.revision
    task.spawn(function()
        local ok,err=pcall(function()
            if plan.reset then
                if essenceCount()~=essences or not essences or essences<1 then error("Reset essence inventory changed. Preview again.",0) end
                status("Requesting reset • waiting for replicated confirmation…")
                remote:FireServer("BattleRoyaleSPReset")
                local confirmed,reason=waitUntil(function()
                    local now=snapshot()
                    if not now or now.stats~=before.stats then return false end
                    for _,v in pairs(now.current) do if v~=0 then return false end end
                    return now.available>=before.available+plan.allocated
                end,rev,8)
                if not confirmed then error(reason,0) end
            end
            for _,change in ipairs(plan.changes) do
                if not state.running or state.revision~=rev then error("Application cancelled; confirmed allocations remain applied.",0) end
                local now,reason=snapshot();if not now then error(reason,0) end
                local delta=change.after-now.current[change.name]
                if delta<0 then error("Stats changed during application. Preview again.",0) end
                if delta>0 then
                    if now.available<delta then error("Insufficient unspent points; application stopped.",0) end
                    status("Allocating "..delta.." to "..change.name.."…")
                    remote:FireServer(change.name,nil,delta)
                    local confirmed,why=waitUntil(function()
                        local latest=snapshot()
                        return latest and latest.stats==now.stats and latest.current[change.name]==change.after and latest.available==now.available-delta
                    end,rev,6)
                    if not confirmed then error(why.." Last request: "..change.name..". Inspect your stats before continuing.",0) end
                end
            end
            local final=snapshot()
            if not final then error("Stat data disappeared after allocation. Inspect your stats.",0) end
            for key,target in pairs(plan.target) do if final.current[key]~=target then error("Final allocation differs from the preview. Inspect your stats.",0) end end
            local expected=plan.reset and before.available+plan.allocated-plan.total or before.available-plan.required
            if final.available~=expected then error("Unspent points changed unexpectedly. Inspect your stats.",0) end
