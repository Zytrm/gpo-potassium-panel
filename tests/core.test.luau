local Core=require("../src/Core")
local passed=0
local function test(name,fn) fn();passed+=1;print("PASS "..name) end
local schema={SwordMastery=true,Defense=true}
test("finite rejects NaN and infinity",function() assert(not Core.finite(0/0));assert(not Core.finite(math.huge));assert(Core.finite(901)) end)
test("invalid points rejected",function() for _,n in ipairs({-1,1.5,math.huge}) do assert(not Core.validateProfile({SwordMastery=n},schema)) end end)
test("unsupported fields rejected",function() assert(not Core.validateProfile({Peli=10},schema)) end)
test("missing fields become zero",function() assert(Core.validateProfile({SwordMastery=901},schema).Defense==0) end)
test("additive plan only spends unallocated points",function() local p=assert(Core.plan({SwordMastery=901,Defense=100},{SwordMastery=800,Defense=100},101,schema));assert(not p.reset and p.required==101 and p.total==1001) end)
test("additive insufficient points rejected",function() assert(not Core.plan({SwordMastery=901,Defense=100},{SwordMastery=800,Defense=100},100,schema)) end)
test("lowering a stat requires reset",function() local p=assert(Core.plan({SwordMastery=901,Defense=0},{SwordMastery=800,Defense=100},1,schema));assert(p.reset and p.required==901 and p.allocated==900) end)
test("reset conserves total point budget",function() assert(not Core.plan({SwordMastery=902,Defense=0},{SwordMastery=800,Defense=100},1,schema)) end)
test("missing current values rejected",function() assert(not Core.plan({SwordMastery=1},{SwordMastery=0},10,schema)) end)
test("profile names bounded",function() assert(Core.validName("Sword"));assert(not Core.validName("\nSword"));assert(not Core.validName(string.rep("x",41)));assert(not Core.validName("   ")) end)
test("configuration excludes disruptive actions",function() local c=Core.sanitize({forward=true,anchor=true,transaction=true,health=true},{F6=true,F7=true,RightShift=true},schema);assert(c.forward==nil and c.anchor==nil and c.transaction==nil and c.health) end)
test("configuration clamps numeric inputs",function() local c=Core.sanitize({speed=999,distance=-5,markerLimit=1000},{},schema);assert(c.speed==150 and c.distance==0 and c.markerLimit==80) end)
test("bad config values use defaults",function() local c=Core.sanitize({speed=0/0,health="yes",keys="bad",profiles=false},{},schema);assert(c.speed==30 and c.health==false) end)
test("conflicting saved bindings revert to defaults",function() local c=Core.sanitize({keys={forward="A",anchor="A",panel="B"}},{A=true,B=true},schema);assert(c.keys.forward=="F6") end)
test("key conflicts do not mutate bindings",function() local k={anchor="F7",forward="F6"};assert(not Core.bind(k,"forward","F7"));assert(k.forward=="F6");assert(Core.bind(k,"forward","K")) end)
test("profiles survive valid config roundtrip",function() local c=Core.sanitize({profiles={Sword={SwordMastery=901,Defense=0},Bad={Peli=1}}},{},schema);assert(c.profiles.Sword.SwordMastery==901 and not c.profiles.Bad) end)
test("configuration has independent nested state",function() local a=Core.defaults();local b=Core.defaults();a.keys.forward="A";a.profiles.Foo={};assert(b.keys.forward=="F6" and not b.profiles.Foo) end)
test("movement is frame-rate independent",function() for _,fps in ipairs({15,30,60,144,240}) do local d=0;for _=1,fps do d+=Core.stepDistance(30,1/fps) end;assert(math.abs(d-30)<0.0001) end end)
test("large frame stalls are bounded",function() assert(Core.stepDistance(150,1)==15) end)
test("all four referenced chest meshes classify",function() for id,category in pairs(Core.ChestMeshes) do assert(Core.classifyEffect("RandomChest","Model",{"rbxassetid://"..id})==category) end end)
test("chest identity comes from mesh, not name",function() assert(not Core.classifyEffect("Legendary Fruit Chest","Model",{}));assert(Core.classifyEffect("LuckyChestV1","Model",{"rbxassetid://10798559852"})=="legendary") end)
test("unknown meshes and nonmodel chests are ignored",function() assert(not Core.classifyEffect("Chest","Model",{"rbxassetid://123"}));assert(not Core.classifyEffect("Chest","Part",{"rbxassetid://10798559852"})) end)
test("every child mesh is considered",function() assert(Core.classifyEffect("Chest","Model",{"rbxassetid://1","rbxassetid://10811929054"})=="mythic") end)
test("ambiguous chest mesh combinations are rejected",function() assert(not Core.classifyEffect("Chest","Model",{"rbxassetid://10798559852","rbxassetid://10811929054"})) end)
test("mesh asset URI formats normalize",function() assert(Core.assetId("https://www.roblox.com/asset/?id=10798559852")=="10798559852");assert(Core.assetId("10798559852")=="10798559852");assert(not Core.assetId("garbage")) end)
test("Black Leg uses the referenced pickup name",function() local c,n,s=Core.classifyEffect("BlackLeg Medal","Model",{});assert(c=="styleMedals" and n=="BlackLeg Medal" and s=="blackleg") end)
test("referenced style medal names classify",function() for name,style in pairs(Core.MedalStyles) do local c,_,s=Core.classifyEffect(name,"Model",{});assert(c=="styleMedals" and s==style) end end)
test("generic medal detector excludes the temporary beam",function() assert(Core.classifyEffect("Golden Medal","Part",{})=="medals");assert(not Core.classifyEffect("medalPiller","Model",{})) end)
test("new chest preferences persist",function() local c=Core.sanitize({common=true,rare=true},{},schema);assert(c.common and c.rare) end)
test("trainer catalogue uses exact identities",function() assert(Core.Trainers.Yome and not Core.Trainers.YomeFake) end)
print(string.format("%d tests passed",passed))
